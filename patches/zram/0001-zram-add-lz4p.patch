+#pragma once
+
+//  Tunables
+#define LZ4_COMPRESS_HASH_BITS 10
+#define LZ4_COMPRESS_HASH_ENTRIES (1 << LZ4_COMPRESS_HASH_BITS)
+#define LZ4_COMPRESS_HASH_MULTIPLY 2654435761U
+#define LZ4_COMPRESS_HASH_SHIFT (32 - LZ4_COMPRESS_HASH_BITS)
